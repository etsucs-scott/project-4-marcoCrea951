<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WorkoutPlanner.UI.MainWindow"
        Title="Workout Planner"
        Width="800" Height="500">

    <StackPanel Margin="20">

        <TextBlock Text="Workout Planner"
                   FontSize="24"
                   HorizontalAlignment="Center"/>

        <ListBox Name="WorkoutList"
                 Height="300"
                 Margin="0,20,0,20"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="Add Workout"
                    Click="AddWorkout_Click"
                    Width="120"
                    Margin="5"/>

            <Button Content="Schedule"
                    Width="120"
                    Margin="5"/>

            <Button Content="Save"
                    Width="120"
                    Margin="5"/>

            <Button Content="Load"
                    Width="120"
                    Margin="5"/>

        </StackPanel>

    </StackPanel>
</Window>